  + removeComponent(componentId: string): ComponentDomainModel
  + updateComponent(updated: ComponentInfo): ComponentDomainModel
  + updateComponentPosition(id: string, x: number, y: number): ComponentDomainModel
  + updateComponentSize(id: string, width: number, height: number): ComponentDomainModel
  + addChildComponent(parentId: string, childId: string): ComponentDomainModel
  + removeChildComponent(parentId: string, childId: string): ComponentDomainModel
  + assignClass(classInfo: ClassInfo, componentId: string): {
        model: ComponentDomainModel
        updatedClass: ClassInfo
    }
  + unassignClass(classInfo: ClassInfo, componentId: string): {
        model: ComponentDomainModel
        updatedClass: ClassInfo
    }
  + deriveRelationships(lowerLevelRelationships: Array<{ id: string; sourceId: string; targetId: string }>, targetKind: ComponentKind): {
        model: ComponentDomainModel
        orphaned: Array<{ relationshipId: string; orphanedIds: string[] }>
    }
  + addRelationship(sourceComponentId: string, targetComponentId: string, label: string): ComponentDomainModel
  + updateRelationshipLabel(relationshipId: string, label: string): ComponentDomainModel
  + removeRelationship(relationshipId: string): ComponentDomainModel
  + addPortConnection(sourceComponentId: string, sourcePortId: string, targetComponentId: string, targetPortId: string, label: string): ComponentDomainModel
  + removePortConnection(connectionId: string): ComponentDomainModel
  + validate(): ValidationResult
  + assertValid(): void
  - deepCopyComponent(comp: ComponentInfo): ComponentInfo
  - wouldCreateCircularReference(parentId: string, childId: string): boolean
  - hasCircularChildReference(): boolean

interface ComponentInfo
  + id: string
  + name: string
  + kind: ComponentKind
  + classIds: string[]
  + childComponentIds: string[]
  + x: number
  + y: number
  + width: number
  + height: number
  + description: string
  + dslPath: string
  + manualPorts: { id: string; name: string; direction: 'input' | 'output' }[]

interface ComponentRelationship
  + id: string
  + sourceComponentId: string
  + targetComponentId: string
  + basedOnIds: string[]
  + label: string

interface PortConnection
  + id: string
  + sourceComponentId: string
  + sourcePortId: string
  + targetComponentId: string
  + targetPortId: string
  + label: string

interface LintClass
  + name: string
  + kind: 'class' | 'interface' | 'struct'
  + isAbstract: boolean
  + extendsName: string | null
  + implementsNames: string[]

interface DslLintWarning
  + code: | 'UNKNOWN_EXTENDS'       // extends で存在しないクラスを参照
    | 'UNKNOWN_IMPLEMENTS'    // implements で存在しないインターフェースを参照
    | 'CIRCULAR_INHERITANCE'  // 循環継承 (extends チェーン)
    | 'CIRCULAR_IMPLEMENTS'
  + message: string
  + className: string
  + refName: string
  + cycle: string[]

interface DomainEvent
  + type: string
  + payload: any

class DomainError
  + constructor(message: string): any

class DomainRuleViolation
  extends DomainError
  + constructor(message: string): any

class DomainValidationError
  extends DomainError
  + constructor(errors: string[]): any

interface ValidationResult
  + isValid: boolean
  + errors: string[]
  + warnings: string[]

interface DomainSnapshot
  + classes: ClassInfo[]
  + timestamp: number
  + version: string

