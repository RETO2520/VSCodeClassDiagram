  + nodes: Array<{
    id: string
    type: string
    label: string
    x: number
    y: number
    metadata?: WorkflowNodeMetadata
  }>
  + edges: Array<{
    from: string
    to: string
    condition?: string | null
    mid?: { x: number; y: number }
    metadata?: {
      semantics?: string
    }
  }>

interface ClassOperation
  + id: string
  + name: string
  + returnType: string
  + visibility: Visibility
  + parameters: OperationParameter[]
  + isStatic: boolean
  + isAbstract: boolean
  + workflow: {
    nodes: Array<{
      id: string
      type: string
      label: string
      x: number
      y: number
      metadata?: WorkflowNodeMetadata
    }>
    edges: Array<{
      from: string
      to: string
      condition?: string | null
      srcs?: { label: string; url: string }[]
      mid?: { x: number; y: number }
      metadata?: {
        semantics?: string
      }
    }>
  }
  + workflowAst: {
    variables: Array<{ name: string; type: string; initialValue?: string }>
