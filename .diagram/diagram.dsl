  - parseMemberLine(line: string): ParsedMember | null
  - parseOperationLine(line: string): ParsedOperation | null
  - extractVisibility(line: string): { visibility: Visibility; rest: string }
  - applyToService(parsedClasses: ParsedClass[], service: ClassDiagramService): void

