  - extractModifiers(node: Node): string[]
    Scenario: 振る舞い
      Given mods を初期化する
      When (node.children.some(c => c.text === 'sta…
      When (node.children.some(c => c.text === 'rea…
      When (node.children.some(c => c.text === 'abs…
      Then modsを返す
  - convertRange(node: Node): vscode.Range
    Scenario: 振る舞い
      Then vscodeを返す

