  + relationship: MemberRelationshipType
  + sourceMultiplicity: Multiplicity
  + targetMultiplicity: Multiplicity
  + needs: MemberNeeds

interface WorkflowNodeMetadata
  + bindings: string[]
  + constraints: StructuredConstraint[]
  + inferredState: string
  + howSteps: string[]
  + whyReason: string

interface OperationWorkflow
  + id: string
  + name: string
  + description: string
  + nodes: Array<{
    id: string
    type: string
    label: string
    x: number
    y: number
    metadata?: WorkflowNodeMetadata
  }>
  + edges: Array<{
    from: string
    to: string
    condition?: string | null
    mid?: { x: number; y: number }
    metadata?: {
      semantics?: string
    }
  }>

interface ClassOperation
  + id: string
  + name: string
  + returnType: string
  + visibility: Visibility
  + parameters: OperationParameter[]
  + isStatic: boolean
  + isAbstract: boolean
  + workflow: {
    nodes: Array<{
      id: string
      type: string
      label: string
      x: number
      y: number
      metadata?: WorkflowNodeMetadata
    }>
    edges: Array<{
      from: string
      to: string
      condition?: string | null
      srcs?: { label: string; url: string }[]
      mid?: { x: number; y: number }
      metadata?: {
        semantics?: string
      }
    }>
  }
  + workflowAst: {
    variables: Array<{ name: string; type: string; initialValue?: string }>
    body: unknown[]
  }

interface EndpointNeeds
  + target: string
  + reason: string

interface ParsedEndpoint
  + id: string
  + method: string
  + path: string
  + needs: EndpointNeeds
  + scenarios: Array<{
    name: string
    steps: Array<{
      keyword: GherkinKeyword
      text: string
      /** Howブロックの場合の実装順指針 */
      howSteps?: string[]
    }>
  }>

interface Relationship
  + id: string
  + type: RelationshipType
  + sourceId: string
  + targetId: string
  + label: string
  + sourceMultiplicity: string
  + targetMultiplicity: string
  + sourceMemberId: string
  + targetMemberId: string

interface HandlerResult
  + success: boolean
  + message: string
  + model: DomainModel
  + events: DomainEvent[]
  + payload: {
        dsl?: string
    }

