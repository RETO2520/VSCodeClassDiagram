  - parser: any
  - isInitialized: any
  + constructor(logger: Logger, extensionUri: vscode.Uri): any
    Scenario: 振る舞い
      And loggerにloggerを設定する
      And extensionUriにextensionUriを設定する
  - initParser(): Promise<boolean>
    Scenario: 振る舞い
      When (this.isInitialized && this.parser)
  + parse(uri: vscode.Uri, content: string): Promise<ClassInfo[]>
    Scenario: 振る舞い
      When (!(await this.initParser()) || !this.par…
  + supports(languageId: string): boolean
    Scenario: 振る舞い
      Then languageId === 'java'を返す
  - visitNode(node: Node, uri: vscode.Uri, classes: ClassInfo[]): void
    Scenario: 振る舞い
      When (node.type === 'class_declaration' || no…
      And iをカウントアップしながら繰り返す
  - extractClassInfo(node: Node, uri: vscode.Uri): ClassInfo
    Scenario: 振る舞い
      Given nameNode, classInfo を初期化する
      When (sc)
      And descendantsOfType の forEach を呼び出す
      And extractMembers を呼び出す
      Then classInfoを返す
  - extractEnumInfo(node: Node, uri: vscode.Uri): ClassInfo
    Scenario: 振る舞い
      Given nameNode を初期化する
      Then text : 'AnonymousEnum',
     …を返す
  - extractStructInfo(node: Node, uri: vscode.Uri): ClassInfo
    Scenario: 振る舞い
      Given nameNode, classInfo を初期化する
      And extractMembers を呼び出す
      Then classInfoを返す
  - determineKind(node: Node): 'class' | 'abstract' | 'interface' | 'struct' | 'enum'
    Scenario: 振る舞い
      When (node.type === 'interface_declaration')
      When (node.type === 'enum_declaration')
      When (node.type === 'struct_declaration')
      And (modifiers && modifiers.text.includes('a…の場合は早期終了
      Then 'class'を返す
  - extractMembers(node: Node, classInfo: ClassInfo): void
    Scenario: 振る舞い
      When (node.type === 'record_declaration')
      When (body)
  - extractOperationInfo(node: Node): OperationInfo
    Scenario: 振る舞い
      Given nameNode, typeNode, paramsNode を初期化する
      Then name: nameNode ? nameNode.text : 'anonymous', returnType: typeNode ? typeNode.text : 'void', parameters: this.extractParameters(paramsNode)を返す
  - extractAttributeInfo(member: Node): AttributeInfo
    Scenario: 振る舞い
      Given typeNode, name を初期化する
      And logger の info を呼び出す
      When (member.type === 'field_declaration')
      Then name: name, type: typeNode ? typeNode.text : 'var', visibility: this.extractVisibility(member)を返す
  - extractParameters(node: Node | null): ParameterInfo[]
    Scenario: 振る舞い
      When (!node)
      And iをカウントアップしながら繰り返す
      Then parametersを返す
  - extractVisibility(node: Node): 'public' | 'protected' | 'private' | 'internal'
    Scenario: 振る舞い
      When (modifiersNode)
      And iをカウントアップしながら繰り返す
      Then 'private'を返す
  - extractModifiers(node: Node): string[]
    Scenario: 振る舞い
      Given mods を初期化する
      When (modifiersNode)
      And iをカウントアップしながら繰り返す
      Then modsを返す
  - convertRange(node: Node): vscode.Range
    Scenario: 振る舞い
      Then vscodeを返す

class CppAstParser
  implements IAstParser
  - logger: Logger
  - extensionUri: vscode.Uri
  - parser: any
  - isInitialized: any
  + constructor(logger: Logger, extensionUri: vscode.Uri): any
    Scenario: 振る舞い
      And loggerにloggerを設定する
      And extensionUriにextensionUriを設定する
  - initParser(): Promise<boolean>
    Scenario: 振る舞い
      When (this.isInitialized && this.parser)
  + parse(uri: vscode.Uri, content: string): Promise<ClassInfo[]>
    Scenario: 振る舞い
      When (!(await this.initParser()) || !this.par…
  + supports(languageId: string): boolean
    Scenario: 振る舞い
      Then languageId === 'cpp' || langua…を返す
  - visitNode(node: Node, uri: vscode.Uri, classes: ClassInfo[]): void
    Scenario: 振る舞い
      When (node.type === 'class_specifier')
      And iをカウントアップしながら繰り返す
  - extractClassInfo(node: Node, uri: vscode.Uri): ClassInfo | null
    Scenario: 振る舞い
      Given nameNode を初期化する
      When (!nameNode)
      When (baseClause)
      When (body && body.type === 'field_declaratio…
      Then classInfoを返す
  - extractStructInfo(node: Node, uri: vscode.Uri): ClassInfo | null
    Scenario: 振る舞い
      Given nameNode を初期化する
      When (!nameNode)
      When (baseClause)
      When (body && body.type === 'field_declaratio…
      Then classInfoを返す
  - extractEnumInfo(node: Node, uri: vscode.Uri): ClassInfo | null
    Scenario: 振る舞い
      Given nameNode を初期化する
      When (!nameNode)
      When (body && body.type === 'enumerator_list'…
      Then classInfoを返す
  - extractBaseClasses(baseClause: Node, classInfo: ClassInfo): void
    Scenario: 振る舞い
      And iをカウントアップしながら繰り返す
  - extractMembers(body: Node, classInfo: ClassInfo): void
    Scenario: 振る舞い
      Given currentVisibility を初期化する
      And iをカウントアップしながら繰り返す
  - extractFieldDeclaration(node: Node, visibility: 'public' | 'protected' | 'private' | 'internal'): AttributeInfo | null
    Scenario: 振る舞い
      Given typeNode, declaratorNode を初期化する
      When (!declaratorNode)
      When (declaratorNode.type === 'function_decla…
      When (declaratorNode.type === 'identifier')
      When (!fieldName)
      Then name: fieldName, type: typeNode ? typeNode.text : 'auto', visibility: visibilityを返す
  - extractFunctionDefinition(node: Node, visibility: 'public' | 'protected' | 'private' | 'internal'): OperationInfo | null
    Scenario: 振る舞い
      Given declarator を初期化する
      When (!declarator || declarator.type !== 'fun…
      When (!funcNameNode)
      Then name: funcNameNode.text, returnType: typeNode ? typeNode.text : 'void', parameters: this.extractParameters(paramsNode)を返す
  - extractFunctionDeclaration(node: Node, visibility: 'public' | 'protected' | 'private' | 'internal'): OperationInfo | null
    Scenario: 振る舞い
      Given declarator を初期化する
      When (!declarator || declarator.type !== 'fun…
      When (!funcNameNode)
      Then name: funcNameNode.text, returnType: typeNode ? typeNode.text : 'void', parameters: this.extractParameters(paramsNode)を返す
  - extractParameters(node: Node | null): ParameterInfo[]
    Scenario: 振る舞い
      When (!node)
      And iをカウントアップしながら繰り返す
      Then parametersを返す
  - extractFieldModifiers(node: Node): string[]
    Scenario: 振る舞い
      Given mods を初期化する
      And iをカウントアップしながら繰り返す
      Then modsを返す
  - extractFunctionModifiers(node: Node): string[]
    Scenario: 振る舞い
      Given mods を初期化する
      And iをカウントアップしながら繰り返す
      When (declarator)
      Then modsを返す
  - findChildByType(node: Node, type: string): Node | null
    Scenario: 振る舞い
      And iをカウントアップしながら繰り返す
      Then nullを返す
  - findDescendantByType(node: Node, type: string): Node | null
    Scenario: 振る舞い
      And iをカウントアップしながら繰り返す
      Then nullを返す
  - convertRange(node: Node): vscode.Range
    Scenario: 振る舞い
      Then vscodeを返す

// インターフェース
interface Attribute
  + name: string
  + type: string
  + visibility: 'public' | 'private' | 'protected' | 'package'
  + modifier: 'None' | 'Static' | 'Abstract'

interface Parameter
  + name: string
  + type: string

interface Operation
  + name: string
  + returnType: string
  + visibility: 'public' | 'private' | 'protected' | 'package'
  + modifier: 'None' | 'Static' | 'Abstract'
  + parameters: Parameter[]

interface ClassModel
  + id: string
  + name: string
  + x: number
  + y: number
  + width: number
  + height: number
  + baseClassId: string | null
  + interfaces: string[]
  + isAbstract: boolean
  + isInterface: boolean
  + attributes: Attribute[]
  + operations: Operation[]
  + baseClass: string

interface DiagramModel
  + classes: ClassModel[]

interface AppState
  + model: DiagramModel
  + editingNameId: string | null
  + editingDraft: string
  + primitiveTypes: string[]

interface Window
  + vscode: {
        postMessage(message: any): void;
        getState(): any;
        setState(state: any): void;
    }
  + adjustSvgSize(): void

interface ActivitySidebarProps
  + mode: EditorMode
  + onModeChange: (mode: EditorMode) => void
  + activeWorkflowLabel: string | null

interface ClassEditorProps
  + classInfo: ClassInfo
