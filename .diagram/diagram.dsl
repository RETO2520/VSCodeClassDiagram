# Relations

Operation +> Parameter :parameters 1 1
ClassModel +> Attribute :attributes 1 1
ClassModel +> Operation :operations 1 1
DiagramModel +> ClassModel :classes 1 1
AppState +> DiagramModel :model 1 1
MockBuilder -/> IObjectModel :Build(model)
TypeScriptBuilder -/> IClassModel :generateImports(cls)
TypeScriptBuilder -/> IClassModel :generateClassDeclaration(cls)
TypeScriptBuilder -/> IClassModel :generateAttributes(cls)
TypeScriptBuilder -/> IClassModel :generateConstructor(cls)
TypeScriptBuilder -/> IClassModel :generateOperations(cls)
TypeScriptBuilder -/> IClassModel :getFileName(cls)
TypeScriptBuilder -/> WorkflowAst :generateWorkflow(ast)
TypeScriptBuilder -/> IClassModel :analyzeAttribute(cls)
TypeScriptBuilder -/> IClassModel :analyzeConstructor(cls)
TypeScriptBuilder -/> IClassModel :analyzeOperation(cls)
TypeScriptBuilder -/> TypeModel :filterOutBuiltins(tm)
RustBuilder -/> IClassModel :generateImports(cls)
RustBuilder -/> IClassModel :generateClassDeclaration(cls)
RustBuilder -/> IClassModel :generateAttributes(cls)
RustBuilder -/> IClassModel :generateConstructor(cls)
