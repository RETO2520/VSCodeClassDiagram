  + updateWorkflow(opId: string, workflow: any, ast: any): DomainModel
  + getWorkflow(opId: string): any
  + addParameter(className: string, operationName: string, parameter: OperationParameter): DomainModel
  + removeParameter(classId: string, operationId: string, parameterId: string): DomainModel
  + validate(): ValidationResult
  + assertValid(): void
  + detectRelationships(): Relationship[]
  - deepCopyClass(cls: ClassInfo): ClassInfo
  - hasCircularInheritance(): boolean
  - wouldCreateCircularInheritance(updatedClass: ClassInfo): boolean
  - extractBaseTypeName(type: string): string
  - isPrimitiveType(type: string): boolean

class DslParseError
  + constructor(message: string, line: number, source: string): any

interface ParsedClass
