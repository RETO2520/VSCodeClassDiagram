        /** 設計意図（Whyステップ） */
        whyReason?: string
    }

interface WFEdge
  + from: string
  + to: string
  + condition: string | null
  + mid: { x: number; y: number }

interface WFWorkflow
  + nodes: WFNode[]
  + edges: WFEdge[]

interface WFOpRef
