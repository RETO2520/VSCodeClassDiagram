interface ComponentDomainSnapshot
  + components: ComponentInfo[]
  + relationships: ComponentRelationship[]
  + portConnections: PortConnection[]
  + timestamp: number
  + version: string

interface ComponentDomainEvent
  + type: string
  + payload: unknown
  + occurredAt: Date

class ComponentAddedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { component: ComponentInfo }): any

class ComponentRemovedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { componentId: string }): any

class ComponentUpdatedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { component: ComponentInfo }): any

class ClassAssignedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { classId: string; componentId: string }): any

class ClassUnassignedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { classId: string; componentId: string }): any

class RelationshipDerivedEvent
  implements ComponentDomainEvent
  + type: any
  + occurredAt: any
  + constructor(payload: { derived: ComponentRelationship[]; orphaned: string[] }): any

class ComponentDomainModel
  + s createEmpty(): ComponentDomainModel
  + s from(components: ComponentInfo[], relationships: ComponentRelationship[], portConnections: PortConnection[]): ComponentDomainModel
  + s fromSnapshot(snapshot: ComponentDomainSnapshot): ComponentDomainModel
  - constructor(componentMap: Map<string, ComponentInfo>, relationshipMap: Map<string, ComponentRelationship>, portConnectionMap: Map<string, PortConnection>): any
  + clone(): ComponentDomainModel
  + toSnapshot(): ComponentDomainSnapshot
  + getComponents(): ComponentInfo[]
  + getComponent(id: string): ComponentInfo | undefined
  + getRelationships(): ComponentRelationship[]
  + getPortConnections(): PortConnection[]
