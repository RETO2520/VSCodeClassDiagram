{
  "name": "class-diagram-editor",
  "displayName": "%package.displayName%",
  "description": "%package.description%",
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.104.0"
  },
  "activationEvents": [
    "onCommand:classDiagram.open",
    "onCommand:workflowDiagram.open",
    "onCommand:sourceToDiagram.generate"
  ],
  "main": "./out/extension.js",
  "workspaces": [
    "frontend",
    "view"
  ],
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "packaging": "npx vsce package --no-dependencies",
    "frontend:build": "npm run build --workspace=frontend",
    "backend:build": "node scripts/build.js",
    "p": "npx vsce package",
    "license-check": "license-checker-rseidelsohn --json --production --summary --out ./THIRD-PARTY-LICENSES.json",
    "license-report": "license-report --output-json --production --summary >  ./THIRD-PARTY-LICENSES.json",
    "generate-license-text": "npm run license-report &&generate-license-file --input package.json --output THIRD-PARTY-LICENSES.txt",
    "build": "npm run build --workspace=frontend && tsc && node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "test:js": "node src/test/js/index.test.js",
    "test": "npm run build && vscode-test",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^25.0.3",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "generate-license-file": "^4.1.1",
    "glob": "^13.0.2",
    "globals": "^17.0.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "license-report": "^6.8.1",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "classDiagram.open",
        "title": "%contributes.commands.classdiagram.title%",
        "category": "class diagram",
        "shortTitle": "open class diagram"
      },
      {
        "command": "workflowDiagram.open",
        "title": "%contributes.commands.workflow.title%",
        "category": "class diagram",
        "shortTitle": "open workflow"
      },
      {
        "command": "sourceToDiagram.generate",
        "title": "Generate Diagram from Source",
        "category": "class diagram",
        "shortTitle": "source to diagram"
      }
    ]
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RETO2520/VSCodeClassDiagram.git"
  },
  "author": "RETO2520",
  "license": "MIT",
  "type": "commonjs",
  "publisher": "reto",
  "pricing": "Free",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.6"
  }
}